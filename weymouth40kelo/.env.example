# Supabase project: "Weymouth 40k Elo" (ref: ukuazcdikzouiuirwnck)
NEXT_PUBLIC_SUPABASE_URL=https://ukuazcdikzouiuirwnck.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — from Supabase dashboard > Project Settings > API > service_role.
# Server-only, never exposed to the browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 4-digit PIN for /admin. Entered once per device (remembered for a year).
# Changing it logs out every device.
ADMIN_PIN=

# Temporary: a BCP session access token (copied from browser devtools after
# logging into bestcoastpairings.com). Short-lived (~1hr) — this is an interim
# approach for manual sync; a longer-lived mechanism is future work if/when
# auto-sync is built.
BCP_SESSION_TOKEN=
